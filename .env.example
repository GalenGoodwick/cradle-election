# Atlas cluster (managed for you already — cluster: persist-sprint, db: shell).
# Fill user:pass for the driver. Leave unset to run entirely in-memory.
MONGODB_URI="mongodb+srv://<user>:<pass>@persist-sprint.pc2cq36.mongodb.net/?retryWrites=true&w=majority"

# Optional. Without it, evaluators run in stub mode (outcome + lens-overlap ranking).
# With it, evaluators are real recused LLM instances that can call the vector-search tool.
ANTHROPIC_API_KEY=""
